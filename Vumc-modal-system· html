<!--
VUMC Reusable Modal System
Use this in any page where you want a popup modal for:
- Plan Your Visit
- Event Registration
- Planning Center / Church Center Giving

HOW TO USE:
1. Paste the CSS into your page <style> block.
2. Paste the modal HTML near the bottom of the page, before </body>.
3. Paste the JavaScript before </body>.
4. Add buttons or links with data-modal-url and optional data-modal-title.

EXAMPLE BUTTONS:
<a href="#" class="btn btn-primary" data-modal-url="plan-visit-form.html" data-modal-title="Plan Your Visit">Schedule a Visit</a>
<a href="#" class="btn btn-primary" data-modal-url="https://your-registration-form-url.com" data-modal-title="Event Registration">Register</a>
<a href="#" class="btn btn-primary" data-modal-url="https://versaillesumc.churchcenter.com/giving" data-modal-title="Give Online">Give Now</a>
-->

<style>
  .vumc-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(10, 14, 20, 0.72);
    backdrop-filter: blur(6px);
    display: none;
    align-items: center;
    justify-content: center;
    padding: 24px;
    z-index: 99999;
  }

  .vumc-modal-overlay.open {
    display: flex;
  }

  .vumc-modal {
    width: min(100%, 1040px);
    height: min(88vh, 860px);
    background: #ffffff;
    border-radius: 28px;
    overflow: hidden;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.28);
    display: flex;
    flex-direction: column;
    position: relative;
    animation: vumcModalIn 220ms ease;
  }

  @keyframes vumcModalIn {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.985);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .vumc-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 20px;
    background: #11161d;
    color: #fff;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }

  .vumc-modal-title-wrap {
    min-width: 0;
  }

  .vumc-modal-kicker {
    margin: 0 0 4px;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #e4cda7;
    font-weight: 700;
  }

  .vumc-modal-title {
    margin: 0;
    font-size: 20px;
    line-height: 1.2;
    font-weight: 700;
  }

  .vumc-modal-close {
    border: 0;
    background: rgba(255,255,255,0.12);
    color: #fff;
    width: 42px;
    height: 42px;
    border-radius: 999px;
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
    flex: 0 0 auto;
  }

  .vumc-modal-close:hover {
    background: rgba(255,255,255,0.18);
  }

  .vumc-modal-body {
    flex: 1;
    background: #f7f4ef;
    position: relative;
  }

  .vumc-modal-frame {
    width: 100%;
    height: 100%;
    border: 0;
    background: #fff;
  }

  .vumc-modal-loading {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    text-align: center;
    color: #5b6470;
    font-size: 16px;
    background: #f7f4ef;
  }

  body.vumc-modal-open {
    overflow: hidden;
  }

  @media (max-width: 767px) {
    .vumc-modal-overlay {
      padding: 0;
      align-items: flex-end;
    }

    .vumc-modal {
      width: 100%;
      height: 100dvh;
      max-height: 100dvh;
      border-radius: 22px 22px 0 0;
    }

    .vumc-modal-header {
      padding: 16px;
    }

    .vumc-modal-title {
      font-size: 18px;
    }
  }
</style>

<div class="vumc-modal-overlay" id="vumcModalOverlay" aria-hidden="true">
  <div class="vumc-modal" role="dialog" aria-modal="true" aria-labelledby="vumcModalTitle">
    <div class="vumc-modal-header">
      <div class="vumc-modal-title-wrap">
        <p class="vumc-modal-kicker">Versailles United Methodist Church</p>
        <h2 class="vumc-modal-title" id="vumcModalTitle">Open Form</h2>
      </div>
      <button class="vumc-modal-close" id="vumcModalClose" aria-label="Close modal">×</button>
    </div>

    <div class="vumc-modal-body">
      <div class="vumc-modal-loading" id="vumcModalLoading">Loading…</div>
      <iframe class="vumc-modal-frame" id="vumcModalFrame" src="" title="VUMC Modal Content"></iframe>
    </div>
  </div>
</div>

<script>
  (function () {
    const overlay = document.getElementById('vumcModalOverlay');
    const frame = document.getElementById('vumcModalFrame');
    const loading = document.getElementById('vumcModalLoading');
    const closeBtn = document.getElementById('vumcModalClose');
    const titleEl = document.getElementById('vumcModalTitle');

    if (!overlay || !frame || !loading || !closeBtn || !titleEl) return;

    let lastTrigger = null;

    function openModal(url, title, triggerEl) {
      if (!url) return;

      lastTrigger = triggerEl || null;
      titleEl.textContent = title || 'Open Form';
      loading.style.display = 'flex';
      frame.src = url;
      overlay.classList.add('open');
      overlay.setAttribute('aria-hidden', 'false');
      document.body.classList.add('vumc-modal-open');
    }

    function closeModal() {
      overlay.classList.remove('open');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('vumc-modal-open');
      frame.src = '';
      loading.style.display = 'flex';

      if (lastTrigger) {
        lastTrigger.focus();
      }
    }

    document.addEventListener('click', function (e) {
      const trigger = e.target.closest('[data-modal-url]');
      if (!trigger) return;

      e.preventDefault();
      const url = trigger.getAttribute('data-modal-url');
      const title = trigger.getAttribute('data-modal-title') || 'Open Form';
      openModal(url, title, trigger);
    });

    closeBtn.addEventListener('click', closeModal);

    overlay.addEventListener('click', function (e) {
      if (e.target === overlay) {
        closeModal();
      }
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && overlay.classList.contains('open')) {
        closeModal();
      }
    });

    frame.addEventListener('load', function () {
      loading.style.display = 'none';
    });

    window.vumcOpenModal = openModal;
    window.vumcCloseModal = closeModal;
  })();
</script>
